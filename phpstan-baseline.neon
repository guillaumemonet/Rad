			count: 1
			path: src/Rad/Collection/Collection.php

		-
			message: '#^Caught class Rad\\Config\\Exception not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/Rad/Config/AutoConfig.php

		-
			message: '#^Right side of \|\| is always false\.$#'
