			count: 2
			path: src/Rad/Codec/JsonCodecHandler.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, Closure\(mixed, mixed\)\: void given\.$#'
