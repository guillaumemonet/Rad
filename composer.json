{
    "name": "rad/rad-framework",
    "description": "Rapid Application Development Framework.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Guillaume Monet",
            "email": "guillaume.monet@free.fr"
        }
    ],
    "autoload": {
        "psr-4": {
            "Rad\\": "src/Rad/"
        },
        "files": [
            "src/Helpers/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Rad\\Test\\": "test/"
        }
    },
    "require": {
        "php": "^8.2",
        "psr/log": "^1.1 || ^2 || ^3",
        "psr/cache": "^1.1 || ^2 || ^3",
        "psr/container": "^1.1 || ^2",
        "psr/http-message": "^1.1 || ^2",
        "psr/link": "^1.1 || ^2",
        "psr/simple-cache": "^3",
        "psr/http-server-middleware": "^1",
        "psr/http-server-handler": "^1",
        "psr/http-factory": "^1",
        "psr/http-client": "^1",
        "psr/event-dispatcher": "^1",
        "guzzlehttp/psr7": "^2.6",
        "smarty/smarty": "^4",
        "nette/php-generator": "^4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "bin": [
        "bin/rad"
    ]
}
